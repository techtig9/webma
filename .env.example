# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini
GEMINI_API_KEY=
# Model names churn every few months — these are current as of this build (mid-2026).
# Verify against Google's live model list before launch: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL_PREMIUM=gemini-3.1-pro
GEMINI_MODEL_LITE=gemini-3.5-flash-lite

# OpenAI (optional — automatic fallback if Gemini errors or is unavailable; if unset,
# behavior is Gemini-only, unchanged from before)
OPENAI_API_KEY=
# Same staleness caveat as the Gemini models above — verify before launch:
# https://openai.com/api/pricing
OPENAI_MODEL_PREMIUM=gpt-5.6-terra
OPENAI_MODEL_LITE=gpt-5.6-luna

# Paddle
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENV=sandbox
PADDLE_PRICE_STARTER_MONTH=
PADDLE_PRICE_STARTER_YEAR=
PADDLE_PRICE_PRO_MONTH=
PADDLE_PRICE_PRO_YEAR=
PADDLE_PRICE_BUSINESS_MONTH=
PADDLE_PRICE_BUSINESS_YEAR=

# Deployment integrations (user-supplied OAuth tokens are stored per-account instead of these,
# these are only needed if you run platform-level deploys during local dev/testing)
VERCEL_API_TOKEN=
NETLIFY_API_TOKEN=

# Per-user deploy OAuth (optional — lets customers connect their OWN Vercel/Netlify
# account so sites deploy under it instead of the platform token above; register an
# OAuth app with each provider first — see comment at the top of src/lib/deploy-oauth.ts)
VERCEL_OAUTH_CLIENT_ID=
VERCEL_OAUTH_CLIENT_SECRET=
NETLIFY_OAUTH_CLIENT_ID=
NETLIFY_OAUTH_CLIENT_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
