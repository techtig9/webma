# ============================================================
# Webma production environment
# Never commit real secrets. Configure these in your deployment
# provider and keep service-role/provider secrets server-side.
# ============================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI providers — Webma uses a fallback chain for lightweight tasks
GROQ_API_KEY=
GROQ_MODEL=
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Complex generation provider
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
CLAUDE_MAX_TOKENS=8192

# AI image generation (distinct pipeline — see src/lib/image-gen.ts)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# Billing / Paddle
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENV=sandbox
PADDLE_PRICE_STARTER_MONTH=
PADDLE_PRICE_STARTER_YEAR=
PADDLE_PRICE_PRO_MONTH=
PADDLE_PRICE_PRO_YEAR=
PADDLE_PRICE_BUSINESS_MONTH=
PADDLE_PRICE_BUSINESS_YEAR=

# Deployment
VERCEL_API_TOKEN=
NETLIFY_API_TOKEN=

# Optional per-user deployment OAuth
VERCEL_OAUTH_CLIENT_ID=
VERCEL_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
NETLIFY_OAUTH_CLIENT_ID=
NETLIFY_OAUTH_CLIENT_SECRET=
# 64 hex characters / 32 bytes
DEPLOY_TOKEN_ENCRYPTION_KEY=

# Transactional email (Resend) — src/lib/email.ts. Without RESEND_API_KEY
# set, every email send throws "RESEND_API_KEY is not set" rather than
# failing silently — check server logs if welcome/payment-failed emails
# aren't arriving.
RESEND_API_KEY=
EMAIL_FROM=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Analytics (optional — falls back to a built-in default if unset, but a
# real deployment should set its own so the daily visitor hash salt isn't
# a value visible in this public repo)
ANALYTICS_HASH_SALT=

# Rate limiting (src/lib/rate-limit.ts) — REQUIRED for a real multi-instance
# or serverless deployment (Vercel included). Without these, rate limiting
# silently falls back to a single-process in-memory counter: every instance
# gets its own independent limit (so the effective limit multiplies by
# however many warm instances handle traffic) and it resets on every cold
# start. Free tier at https://console.upstash.com is enough to start.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared secret Supabase's Database Webhooks sends back on user-created
# events (src/app/api/webhooks/user-created/route.ts) — set the same value
# here and in the webhook's configured header in the Supabase dashboard.
USER_EVENTS_WEBHOOK_SECRET=

# Sentry (optional)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
