# ============================================================
# Webma production environment
# Never commit real secrets. Configure these in your deployment
# provider and keep service-role/provider secrets server-side.
#
# The app builds and public/auth pages render with ZERO of these set.
# Anything that needs a missing credential fails at request time with a
# clear "not configured" message instead of crashing.
# ============================================================

# --- Supabase — REQUIRED for auth, database, and storage to work at all ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI providers — Webma uses a fallback chain for lightweight tasks.
# REQUIRED for website generation to work; each is individually optional
# but at least one lightweight provider (Groq/Cerebras/OpenRouter) plus
# ANTHROPIC_API_KEY is needed for the full generation flow. ---
GROQ_API_KEY=
GROQ_MODEL=
# Optional — voice-to-text model override for Groq Whisper transcription
# (src/lib/gemini.ts). Defaults to whisper-large-v3.
GROQ_WHISPER_MODEL=
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- Complex generation provider — REQUIRED for full-site AI generation ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
CLAUDE_MAX_TOKENS=8192

# --- AI image generation (distinct pipeline — see src/lib/image-gen.ts).
# Optional — AI image generation is unavailable without it, rest of the
# app is unaffected. ---
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# --- Billing / Paddle — optional; without these, billing/checkout is
# unavailable but the rest of the app works. REQUIRED if you want plans,
# credits purchases, or subscriptions to function. ---
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENV=sandbox
PADDLE_PRICE_STARTER_MONTH=
PADDLE_PRICE_STARTER_YEAR=
PADDLE_PRICE_PRO_MONTH=
PADDLE_PRICE_PRO_YEAR=
PADDLE_PRICE_BUSINESS_MONTH=
PADDLE_PRICE_BUSINESS_YEAR=

# --- Deployment — optional; without these, users can still export their
# site but in-app one-click deploy is unavailable. ---
VERCEL_API_TOKEN=
NETLIFY_API_TOKEN=

# --- Optional per-user deployment OAuth — lets a site deploy under the
# customer's own Vercel/GitHub/Netlify account instead of the platform
# token above. Optional; each provider's "Connect" button shows a clear
# "not configured" error until its own CLIENT_ID/SECRET pair is set. ---
VERCEL_OAUTH_CLIENT_ID=
VERCEL_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
NETLIFY_OAUTH_CLIENT_ID=
NETLIFY_OAUTH_CLIENT_SECRET=
# REQUIRED if any *_OAUTH_CLIENT_SECRET above is set — 64 hex characters
# (32 bytes), e.g. `openssl rand -hex 32`. Encrypts stored OAuth tokens.
DEPLOY_TOKEN_ENCRYPTION_KEY=

# --- Transactional email (Resend) — src/lib/email.ts. Optional; without
# RESEND_API_KEY set, every email send throws "RESEND_API_KEY is not set"
# rather than failing silently — check server logs if welcome/payment-failed
# emails aren't arriving. ---
RESEND_API_KEY=
EMAIL_FROM=

# Optional — sends every outgoing user-facing email to this one address
# instead of the real recipient (the real recipient is still appended to
# the subject line and recorded in the audit log) — set this in staging so
# the full send pipeline can be tested against a real Resend account
# without ever reaching an actual user. Leave unset in production.
EMAIL_TEST_OVERRIDE_TO=

# Optional — owner/admin notifications (src/lib/email.ts's notifyAdmin) —
# new signups, subscription changes, payments, bug reports. Notifications
# are silently skipped (not an error) when this isn't set.
ADMIN_NOTIFICATION_EMAIL=

# --- App — REQUIRED in any real deployment (defaults to localhost, wrong
# for anything but local dev: OAuth redirect URIs, email links, sitemap/
# robots.txt, and social-preview metadata all derive from this). ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — falls back to a built-in default if unset, but a real
# deployment should set its own so the daily visitor hash salt isn't a
# value visible in this public repo.
ANALYTICS_HASH_SALT=

# --- Rate limiting (src/lib/rate-limit.ts) — REQUIRED for a real
# multi-instance or serverless deployment (Vercel included). Without these,
# rate limiting silently falls back to a single-process in-memory counter:
# every instance gets its own independent limit (so the effective limit
# multiplies by however many warm instances handle traffic) and it resets
# on every cold start. Free tier at https://console.upstash.com is enough
# to start. ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional — shared secret Supabase's Database Webhooks sends back on
# user-created events (src/app/api/webhooks/user-created/route.ts) — set
# the same value here and in the webhook's configured header in the
# Supabase dashboard.
USER_EVENTS_WEBHOOK_SECRET=

# Optional — set to "true" only in local/dev to bypass all credit and
# plan-feature gating (src/lib/credits.ts). Never set this in a real
# deployment.
TESTING_MODE=

# --- Sentry (optional) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
